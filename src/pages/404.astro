---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Galih Giri" description="The requested page could not be located.">
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4">
    <div class="max-w-md text-center">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-blue-50 border border-blue-200 text-brand-accent flex items-center justify-center font-mono font-bold text-2xl mb-6">
        404
      </div>
      <h1 class="text-3xl font-extrabold text-brand-navy tracking-tight mb-3">Page Not Found</h1>
      <p class="text-sm text-brand-slate mb-8 leading-relaxed">
        The link you followed may be broken or the page may have been moved. Return to the homepage or explore selected case studies.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="px-6 py-3 rounded-xl bg-brand-navy text-white text-xs font-semibold tracking-wide uppercase hover:bg-brand-deep transition-all shadow-sm">
          Return Home
        </a>
        <a href="/#case-studies" class="px-6 py-3 rounded-xl bg-white border border-brand-border text-brand-slate text-xs font-semibold tracking-wide uppercase hover:text-brand-accent transition-all shadow-sm">
          Case Studies
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
